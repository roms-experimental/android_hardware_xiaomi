type hal_displayfeature_xiaomi_default, domain;
hal_client_domain(hal_displayfeature_xiaomi_default, vendor_hal_display_color)
hal_client_domain(hal_displayfeature_xiaomi_default, vendor_hal_display_postproc)
hal_server_domain(hal_displayfeature_xiaomi_default, hal_displayfeature_xiaomi)

type hal_displayfeature_xiaomi_default_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(hal_displayfeature_xiaomi_default)

binder_call(hal_displayfeature_xiaomi_client, hal_displayfeature_xiaomi_server)
binder_call(hal_displayfeature_xiaomi_default, hal_graphics_composer_default)
binder_call(hal_displayfeature_xiaomi_server, hal_displayfeature_xiaomi_client)

hal_attribute_hwservice(hal_displayfeature_xiaomi, hal_displayfeature_xiaomi_hwservice)

allow hal_displayfeature_xiaomi_default vendor_hal_display_config_hwservice:hwservice_manager find;
allow hal_displayfeature_xiaomi_default vendor_qdisplay_service:service_manager find;

rw_dir_file(hal_displayfeature_xiaomi, vendor_sysfs_graphics)

get_prop(hal_displayfeature_xiaomi_default, vendor_mpctl_prop)
set_prop(hal_displayfeature_xiaomi_default, vendor_displayfeature_prop)

unix_socket_connect(hal_displayfeature_xiaomi_default, vendor_pps, hal_graphics_composer_default)
vndbinder_use(hal_displayfeature_xiaomi)
